# Salin ke environment variable di hosting Anda (jangan commit nilai asli ke GitHub).
# WAJIB untuk Global Leaderboard:
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Isi true jika penyedia database mewajibkan SSL (Neon, Supabase, Render, Railway publik, dll.)
DATABASE_SSL=true
# Opsional (disarankan): kunci penanda token login, minimal 16 karakter acak. Kosong = dibuat otomatis & disimpan di database.
AUTH_SECRET=
# Opsional - batas anti-curang (nilai bawaan ditampilkan)
MIN_ROUND_SECONDS=30
TOURNAMENT_MIN_HUMANS=2
MAX_TOURNAMENTS_PER_HOUR=12
MAX_TOURNAMENTS_PER_DAY=100
DATABASE_POOL_MAX=10
